# Database - PostgreSQL (Neon, Supabase ou local)
DATABASE_URL="postgresql://user:password@localhost:5432/english_school?sslmode=require"

# NextAuth Security & URLs (mínimo 32 caracteres)
# Gere um valor forte: `openssl rand -base64 32`
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Criptografia de Dados Sensíveis (AES-256-GCM - Exatos 32 Caracteres)
# Gere um valor forte: `openssl rand -hex 16` (32 chars)
ENCRYPTION_KEY=""

# Upstash Redis (Rate Limiting em Produção)
KV_REST_API_URL=""
KV_REST_API_TOKEN=""

# Número de proxies confiáveis à frente da app (Vercel/Cloudflare/nginx = 1)
TRUSTED_PROXY_COUNT="1"

# Pagamentos (Stripe - Opcional)
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Chave Dedicada para Assinatura do Sandbox de Pagamento (Opcional - mínimo 32 caracteres)
SANDBOX_SIGNING_KEY=""

# Calendly & Agendamento
NEXT_PUBLIC_CALENDLY_URL=""
CALENDLY_API_TOKEN=""

# WhatsApp Business Cloud API (Meta - opcional)
# Requer um token com a permissão whatsapp_business_messaging e o Phone Number ID.
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_GRAPH_VERSION="v23.0"
WHATSAPP_DEFAULT_COUNTRY_CODE="55"

# Observabilidade & Sentry (Opcional)
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_DSN=""

# Email SMTP (Opcional)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="noreply@englishschool.com"

# Google Gemini AI (Tutor IA & Scanner de Segurança Garak)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# ElevenLabs TTS (opcional; substitui a voz do navegador quando configurado)
ELEVENLABS_API_KEY="" # gitleaks:allow — placeholder vazio de documentação
ELEVENLABS_VOICE_ID=""
ELEVENLABS_MODEL_ID="eleven_multilingual_v2"
ELEVENLABS_OUTPUT_FORMAT="mp3_44100_128"

# Google Analytics & Tag Manager (Opcional)
NEXT_PUBLIC_GA_ID=""
NEXT_PUBLIC_GTM_ID=""
GOOGLE_SITE_VERIFICATION=""
