# Database - PostgreSQL (Neon, Supabase ou local)
DATABASE_URL="postgresql://user:password@localhost:5432/english_school?sslmode=require"

# NextAuth Security & URLs
NEXTAUTH_SECRET="sua-chave-secreta-nextauth-minimo-32-chars"
NEXTAUTH_URL="http://localhost:3000"

# Criptografia de Dados Sensíveis (AES-256-GCM - Exatos 32 Caracteres)
ENCRYPTION_KEY="12345678901234567890123456789012"

# Upstash Redis (Rate Limiting em Produção)
KV_REST_API_URL="https://your-upstash-instance.upstash.io"
KV_REST_API_TOKEN="your_upstash_token"

# Pagamentos (Stripe - Opcional)
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_your_stripe_publishable_key"
STRIPE_WEBHOOK_SECRET="whsec_your_webhook_secret"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Calendly & Agendamento
NEXT_PUBLIC_CALENDLY_URL="https://calendly.com/your-calendly-url"
CALENDLY_API_TOKEN="your-calendly-api-token"

# Observabilidade & Sentry (Opcional)
NEXT_PUBLIC_SENTRY_DSN="https://your-sentry-dsn@ingest.sentry.io/project"
SENTRY_DSN="https://your-sentry-dsn@ingest.sentry.io/project"

# Email SMTP (Opcional)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"
EMAIL_FROM="noreply@englishschool.com"
