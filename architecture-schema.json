  "flows": [
    {
      "id": "flow_lead_onboarding",
      "name": "1. Lead Capture & Onboarding Automático",
      "description": "Visitante preenche formulário de demonstração/aula experimental na landing page. O lead é validado contra XSS, gravado no banco, notificado por WhatsApp/Email e direcionado ao agendamento.",
      "trigger": "Submissão de formulário em / ou /planos",
      "securityGuards": ["Rate limiter de IP", "Sanitização Zod + DOMPurify", "AuditLog de criação"],
      "color": "#3B82F6",
      "steps": [
        {
          "step": 1,
          "from": "client_browser",
          "to": "edge_proxy",
          "action": "POST /api/leads",
          "payload": "{ name, email, phone, source, level }",
          "securityCheck": "Verificação de cabeçalhos de segurança e IP confiável."
        },
        {
          "step": 2,
          "from": "edge_proxy",
          "to": "rate_limiter",
          "action": "checkRateLimit(apiRateLimiter)",
          "payload": "Identifier IP",
          "securityCheck": "Verifica cota de 100 reqs/min por IP."
        },
        {
          "step": 3,
          "from": "rate_limiter",
          "to": "api_leads",
          "action": "Validação de Schema (leadSchema)",
          "payload": "Dados do Lead",
          "securityCheck": "Zod valida formato do email, telefone e sanitiza inputs."
        },
        {
          "step": 4,
          "from": "api_leads",
          "to": "service_layer",
          "action": "LeadService.createLead() & WhatsAppService",
          "payload": "Lead Data",
          "securityCheck": "Criação atômica e disparo de eventos de mensageria."
        },
        {
          "step": 5,
          "from": "service_layer",
          "to": "database_neon",
          "action": "prisma.lead.create() + prisma.auditLog.create()",
          "payload": "Lead Record",
          "securityCheck": "Persistência em PostgreSQL Neon com SSL ativado."
        },
        {
          "step": 6,
          "from": "service_layer",
          "to": "external_comms",
          "action": "sendWelcomeEmail() & sendWelcomeWhatsApp()",
          "payload": "Templates de Boas-Vindas",
          "securityCheck": "Comunicação segura com links autenticados para Calendly."
        }
      ]
    },
    {
      "id": "flow_auth_2fa_revocation",
      "name": "2. Autenticação Segura, 2FA & Revogação Dinâmica",
      "description": "Login com credenciais bcrypt (cost 12), desafio 2FA TOTP (segredos AES-256-GCM), bloqueio após 5 falhas e revogação dinâmica de sessão JWT.",
      "trigger": "Submissão em /login",
      "securityGuards": ["Lockout de conta (5 falhas = 15min)", "AES-256-GCM para 2FA Secret", "Invalidação por passwordChangedAt"],
      "color": "#10B981",
      "steps": [
        {
          "step": 1,
          "from": "client_browser",
          "to": "edge_proxy",
          "action": "POST /api/auth/callback/credentials",
          "payload": "{ email, password, twoFactorToken }",
          "securityCheck": "CSP nonce e anti-spoofing de IP."
        },
        {
          "step": 2,
          "from": "edge_proxy",
          "to": "rate_limiter",
          "action": "checkRateLimit(authRateLimiter)",
          "payload": "Identifier IP",
          "securityCheck": "Proteção contra força bruta (máximo 5 tentativas/5min)."
        },
        {
          "step": 3,
          "from": "rate_limiter",
          "to": "auth_engine",
          "action": "NextAuth authorize()",
          "payload": "Credenciais",
          "securityCheck": "Checa lockedUntil e deletedAt no banco."
        },
        {
          "step": 4,
          "from": "auth_engine",
          "to": "database_neon",
          "action": "bcrypt.compare(password, user.password)",
          "payload": "Hash Check",
          "securityCheck": "Bcrypt Cost 12. Se falhar, incrementa failedLoginCount."
        },
        {
          "step": 5,
          "from": "auth_engine",
          "to": "service_layer",
          "action": "verifyTwoFactorToken(token, decrypt(secret))",
          "payload": "TOTP Token",
          "securityCheck": "Descriptografa segredo AES-256-GCM e valida TOTP com tolerância window=1."
        },
        {
          "step": 6,
          "from": "auth_engine",
          "to": "client_browser",
          "action": "Retorna Sessão JWT Assinada",
          "payload": "Session Cookie",
          "securityCheck": "Sessão com maxAge de 8h e verificação contínua no callback jwt."
        }
      ]
    },
    {
      "id": "flow_subscription_checkout",
      "name": "3. Assinatura de Planos & Checkout Stripe / Sandbox",
      "description": "Aluno seleciona plano de inglês. O servidor calcula o preço canônico, inicializa o Stripe Checkout (ou Sandbox assinado via HMAC) e processa webhook de ativação.",
      "trigger": "Clique em 'Assinar' em /planos",
      "securityGuards": ["Preços canônicos no servidor (SERVER_PLAN_PRICES)", "Assinatura Stripe Webhook HMAC", "Sandbox isolado"],
      "color": "#8B5CF6",
      "steps": [
        {
          "step": 1,
          "from": "client_browser",
          "to": "edge_proxy",
          "action": "POST /api/stripe/checkout",
          "payload": "{ plan: 'STANDARD' }",
          "securityCheck": "Requer usuário autenticado (getAuthenticatedUser)."
        },
        {
          "step": 2,
          "from": "edge_proxy",
          "to": "rbac_demo_guard",
          "action": "blockDemoMutations(user)",
          "payload": "User Context",
          "securityCheck": "Se for usuário demo, retorna 403 Forbidden imediatamente."
        },
        {
          "step": 3,
          "from": "rbac_demo_guard",
          "to": "api_stripe_payments",
          "action": "PaymentService.createCheckout()",
          "payload": "CheckoutRequest",
          "securityCheck": "Valida plano contra SERVER_PLAN_PRICES canônico no servidor."
        },
        {
          "step": 4,
          "from": "api_stripe_payments",
          "to": "external_stripe",
          "action": "stripe.checkout.sessions.create()",
          "payload": "Line Items Canônicos",
          "securityCheck": "Cria sessão Stripe com metadata={userId, plan} ou Sandbox Token assinado."
        },
        {
          "step": 5,
          "from": "external_stripe",
          "to": "api_stripe_payments",
          "action": "POST /api/stripe/webhook (checkout.session.completed)",
          "payload": "Stripe Event + Signature Header",
          "securityCheck": "stripe.webhooks.constructEvent() com STRIPE_WEBHOOK_SECRET."
        },
        {
          "step": 6,
          "from": "api_stripe_payments",
          "to": "database_neon",
          "action": "prisma.student.upsert() + prisma.payment.create()",
          "payload": "Ativação de Matrícula",
          "securityCheck": "Transação atômica que ativa o status do aluno e agenda próximo vencimento."
        }
      ]
    },
    {
      "id": "flow_live_classroom",
      "name": "4. Agendamento & Sala de Aula ao Vivo (Jitsi Meet)",
      "description": "Professor ou aluno agenda aula ao vivo. O sistema gera ID de sala aleatório não-previsível, vincula ao professor e aluno e despacha lembretes.",
      "trigger": "Agendamento em /aluno ou /admin",
      "securityGuards": ["Hashes de sala criptograficamente aleatórios", "Isolamento de acesso aluno-professor", "CSP frame-src meet.jit.si"],
      "color": "#EC4899",
      "steps": [
        {
          "step": 1,
          "from": "client_browser",
          "to": "edge_proxy",
          "action": "POST /api/live-sessions",
          "payload": "{ title, scheduledFor, duration, teacherId }",
          "securityCheck": "Verificação de permissão e rate limiting."
        },
        {
          "step": 2,
          "from": "edge_proxy",
          "to": "rbac_demo_guard",
          "action": "blockDemoMutations(user)",
          "payload": "User Context",
          "securityCheck": "Impede agendamento real em modo demonstração."
        },
        {
          "step": 3,
          "from": "rbac_demo_guard",
          "to": "api_students_classes",
          "action": "LiveSessionService.createSession()",
          "payload": "Session Specs",
          "securityCheck": "Gera roomName aleatório seguro com crypto.randomBytes."
        },
        {
          "step": 4,
          "from": "api_students_classes",
          "to": "database_neon",
          "action": "prisma.liveSession.create()",
          "payload": "LiveSession Record",
          "securityCheck": "Salva sessão com status SCHEDULED indexado."
        },
        {
          "step": 5,
          "from": "api_students_classes",
          "to": "external_comms",
          "action": "sendClassReminderWhatsApp()",
          "payload": "Lembrete com Link da Aula",
          "securityCheck": "Disparo de notificação via WhatsApp/Email."
        },
        {
          "step": 6,
          "from": "client_browser",
          "to": "external_comms",
          "action": "Carrega Jitsi Meet Iframe",
          "payload": "meet.jit.si/roomName",
          "securityCheck": "Permissions-Policy com camera e microphone autorizados exclusivamente para self e meet.jit.si."
        }
      ]
    },
    {
      "id": "flow_ai_tutor",
      "name": "5. IA Tutor Alex (Resiliência, Caos & Defesa de Prompt)",
      "description": "Aluno pratica conversação em inglês com Alex. O sistema protege contra jailbreaks, sanitiza o histórico e aciona fallback de modelo se houver quota 429.",
      "trigger": "Envio de mensagem no componente AiTutorCard",
      "securityGuards": ["System Instruction Anti-Jailbreak", "Multi-Model Fallback (Gemini Flash -> Flash 8b)", "Sliding Window Rate Limit 30/min"],
      "color": "#F59E0B",
      "steps": [
        {
          "step": 1,
          "from": "client_browser",
          "to": "edge_proxy",
          "action": "POST /api/ai/tutor",
          "payload": "{ message, history: [...] }",
          "securityCheck": "Requer sessão ativa de aluno ou admin."
        },
        {
          "step": 2,
